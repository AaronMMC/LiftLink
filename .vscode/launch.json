{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SAM Local Invoke",
      "type": "debugpy",
      "request": "launch",
      "runtime": "integratedTerminal",
      "program": "${workspaceFolder}/backend/.aws-sam/build/${input:samFunctionName}/app.py",
      "env": {
        "AWS_SAM_LOCAL": "true",
        "AWS_DEFAULT_REGION": "us-east-1"
      },
      "args": ["${input:samEventFile}"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "AWS_DEFAULT_REGION": "us-east-1"
      }
    },
    {
      "name": "Debug pytest (all tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "AWS_DEFAULT_REGION": "us-east-1"
      }
    }
  ],
  "inputs": [
    {
      "id": "samFunctionName",
      "type": "pickString",
      "description": "Select the SAM function to invoke",
      "options": [
        "CreateProfileFunction",
        "GetProfileFunction",
        "UpdateProfileFunction",
        "SearchInstructorsFunction",
        "GetHistoryFunction",
        "CreateEntryFunction",
        "ListEntriesFunction"
      ]
    },
    {
      "id": "samEventFile",
      "type": "pickString",
      "description": "Select the event file to use",
      "options": [
        "events/create_profile_event.json",
        "events/get_profile_event.json",
        "events/update_profile_event.json",
        "events/search_instructors_event.json",
        "events/get_history_event.json",
        "events/create_entry_event.json",
        "events/list_entries_event.json"
      ]
    }
  ]
}
