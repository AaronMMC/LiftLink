# Copy to .env and fill in real values.
# Never commit a real .env — it's in .gitignore.

# AWS
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=LiftLinkTable-dev

# Cognito (filled after first deploy)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# API (filled after first deploy)
API_BASE_URL=

# Frontend (prefix with VITE_ for Vite)
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=us-east-1
